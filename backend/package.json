{
  "name": "platform-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme collaborative - Backend API (Auth, Securite, Admin & Dashboards)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file-if-exists=.env database/init-db.js",
    "db:seed": "node --env-file-if-exists=.env database/init-db.js --seed",
    "dev:dashboards": "node --env-file-if-exists=.env src/modules/dashboards/dev-server.js",
    "token:demo": "node --env-file-if-exists=.env database/demo-token.js",
    "token:dashboards": "node --env-file-if-exists=.env src/modules/dashboards/dev-server.js --token",
    "test:dashboards": "node --test \"src/modules/dashboards/tests/*.test.js\"",
    "test:analytics": "tsx --env-file-if-exists=.env --test \"src/modules/analytics/tests/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
