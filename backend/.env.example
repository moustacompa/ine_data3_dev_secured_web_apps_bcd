
# Port d'écoute de l'API
PORT=5000

# Connexion PostgreSQL (utilise le port 5435 configuré dans docker)
DATABASE_URL=postgres://dev_user:dev_password123!@localhost:5435/platform_db

# Clé secrète de signature des JWT (en production, cette chaîne doit être ultra longue et aléatoire)
JWT_SECRET=super_secret_jwt_key_pour_notre_projet_securise_2026!
JWT_EXPIRES_IN=24h

# Sécurité CORS (autorise les requêtes provenant du futur frontend React)
CLIENT_URL=http://localhost:3000
NODE_ENV=development